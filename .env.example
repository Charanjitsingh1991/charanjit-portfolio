# ---- Database: Neon (PostgreSQL) ----
# Neon gives you TWO strings in its dashboard. Use the POOLED one for DATABASE_URL
# and the DIRECT (non-pooled) one for DIRECT_URL (used by prisma migrate/db push).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Admin login ----
ADMIN_EMAIL="charanjit@thecharanjitsingh.com"
# Generate a hash locally:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD',10))"
ADMIN_PASSWORD_HASH="$2a$10$REPLACE_WITH_GENERATED_HASH"

# ---- Session signing (any long random string) ----
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"
