# Hostinger production environment. Add these in the Hostinger application settings.
SITE_URL="https://thecharanjitsingh.com"

# Hostinger MySQL. URL-encode special characters in USER and PASSWORD.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

ADMIN_EMAIL="charanjit@thecharanjitsingh.com"
# Generate with npm run admin:credentials. Base64 avoids dotenv dollar interpolation.
ADMIN_PASSWORD_HASH_BASE64=""
AUTH_SECRET=""

# Hostinger Email SMTP. Port 465 uses SMTP_SECURE=true; port 587 uses false.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="portfolio@thecharanjitsingh.com"
SMTP_PASSWORD=""
EMAIL_FROM="Charanjit Singh <portfolio@thecharanjitsingh.com>"
CONTACT_EMAIL="charanjit@thecharanjitsingh.com"

# Persistent filesystem storage on the Hostinger Node.js server.
HOSTINGER_UPLOADS="true"
UPLOADS_DIR="./storage/portfolio-uploads"

# Development-only JSON storage when DATABASE_URL is absent.
# ALLOW_LOCAL_STORAGE="true"
# LOCAL_DATA_DIR=".data"

# Secure daily Hostinger cron endpoint and optional Google PageSpeed API quota.
CRON_SECRET=""
PAGESPEED_API_KEY=""
